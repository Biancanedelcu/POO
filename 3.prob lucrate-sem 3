#include <iostream>
#include <string>

using namespace std;

class Carte 
{
private:
    const int codIsbn;
    string titlu;
    string autor;
    int nrPagini;

    static int secventialIsbn;

public:
    //Constructor fara parametri
    Carte() : codIsbn(1000 + ++secventialIsbn) 
    {
        titlu = "Anonim";
        autor = "Necunoscut";
        nrPagini = 0;
    }

    //Constructor cu parametri
    Carte(string titlu, string autor, int nrPagini) : codIsbn(1000 + ++secventialIsbn) 
    {
        this->titlu = titlu;
        this->autor = autor;
        this->nrPagini = nrPagini;
    }

    // Getteri
    string getTitlu() const 
    {
        return titlu;
    }

    string getAutor() const 
    {
        return autor;
    }

    int getNrPagini() const 
    {
        return nrPagini;
    }

    // Metoda de verificare
    bool esteVolumMare() const 
    {
        return nrPagini >= 300;
    }
};

// Initializare membru static
int Carte::secventialIsbn = 0;

int main() 
{
    int totalCarti = 5;

    //Alocam un vector de pointeri la obiecte
    Carte** biblioteca = new Carte*[totalCarti];

    biblioteca[0] = new Carte("Duna", "Frank Herbert", 680);
    biblioteca[1] = new Carte("Micul Print", "Antoine de Saint-Exupery", 96);
    biblioteca[2] = new Carte("1984", "George Orwell", 328);
    biblioteca[3] = new Carte("Ferma Animalelor", "George Orwell", 112);
    biblioteca[4] = new Carte("Karamazov", "Feodor Dostoievski", 820);

    cout << "Cartile voluminoase (cel putin 300 de pagini) sunt:\n";
    for (int i = 0; i < totalCarti; i++) 
    {
        if (biblioteca[i]->esteVolumMare()) 
        {
            cout << "- " << biblioteca[i]->getTitlu() 
                 << " de " << biblioteca[i]->getAutor() 
                 << " (" << biblioteca[i]->getNrPagini() << " pagini)\n";
        }
    }

    //Eliberare memorie
    for (int i = 0; i < totalCarti; i++) 
    {
        delete biblioteca[i];
    }
    delete[] biblioteca;

    return 0;
}

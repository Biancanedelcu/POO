#include <iostream>

using namespace std;

// Elim toate numerele neg si ajusteaza dimensiunea memoriei
void eliminaNegative(int*& v, int& n) 
{
    int contorPozitive = 0;
    
    // 1. Aflam cate numere pozitive/nule avem
    for (int i = 0; i < n; i++) 
    {
        if (v[i] >= 0) 
        {
            contorPozitive++;
        }
    }

    // Daca toate sunt negative,vectorul devine gol
    if (contorPozitive == 0) 
    {
        delete[] v;
        v = nullptr;
        n = 0;
        return;
    }

    // 2. Alocam un vector nou doar pentru elementele valide
    int* vNou = new int[contorPozitive];
    int idx = 0;

    for (int i = 0; i < n; i++) 
    {
        if (v[i] >= 0) 
        {
            vNou[idx++] = v[i];
        }
    }

    // 3. Eliberam memoria veche si actualizam
    delete[] v;
    v = vNou;
    n = contorPozitive;
}

void afiseaza(const int* v, int n) 
{
    if (n == 0) 
    {
        cout << "Vectorul este gol!\n";
        return;
    }

    for (int i = 0; i < n; i++) 
    {
        cout << "v[" << i << "] = " << v[i] << "\n";
    }
}

int main() 
{
    int n;
    cout << "Dimensiune initiala: ";
    cin >> n;

    int* v = new int[n];
    cout << "Introduceti elementele (pozitive si negative):\n";
    for (int i = 0; i < n; i++) 
    {
        cout << "v[" << i << "] = ";
        cin >> v[i];
    }

    eliminaNegative(v, n);

    cout << "\nVectorul fara numere negative:\n";
    afiseaza(v, n);

    if (v != nullptr) 
    {
        delete[] v;
    }

    return 0;
}
